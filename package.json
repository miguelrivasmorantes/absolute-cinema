		"serve": "vite preview --host 0.0.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"flowbite": "^3.1.2",
		"flowbite-svelte": "^0.47.4",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.0.6",
		"bootstrap": "^5.3.3",
		"tailwindcss": "^4.0.6"
	}
}
